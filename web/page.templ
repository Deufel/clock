package web

import (
	"fmt"

	"github.com/Deufel/clock/internal/state"
)

// stickCSSHref is pinned to your toolbox repo. Bump the commit when you ship
// changes to the framework.
const stickCSSHref = "https://cdn.jsdelivr.net/gh/Deufel/toolbox@master/css/style.css"

// datastarSrc is the Datastar bundle.
const datastarSrc = "https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.1/bundles/datastar.js"

// ---------------------------------------------------------------------------
// Shell — used by /tasks and /admin. Landing has its own simpler shell.
// ---------------------------------------------------------------------------

templ Shell(title, streamURL string, user *state.User, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-ui-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href={ stickCSSHref }/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<script type="module" src={ datastarSrc }></script>
		</head>
		<body
			class="page stage"
			data-signals="{theme: 'dark', typeIdx: 1, hue: 18}"
			data-effect="document.documentElement.setAttribute('data-ui-theme', $theme); document.documentElement.style.setProperty('--hue', $hue); document.documentElement.style.setProperty('--scale', ['0.85', '1', '1.15'][$typeIdx])"
			data-init={ fmt.Sprintf("@get('%s', {openWhenHidden: true})", streamURL) }
		>
			<div class="pg-banner flank-end" style="--hue-shift: 30; --bg: 0.55; --fg: -1; --type: -0.5">
				<span>
					<strong>Demo</strong> — portfolio project. Real-time, server-driven, single-binary Go.
					<a href="https://github.com/Deufel/clock" target="_blank" rel="noopener" style="color: inherit; text-decoration: underline">Source</a>.
				</span>
				<button class="icon-btn" aria-label="Dismiss" onclick="this.parentElement.remove()">✕</button>
			</div>
			<header class="pg-header flank-end">
				<a href="/tasks" class="row" style="--type: 1; text-decoration: none; align-items: center; gap: 0.5em">
					@templ.Raw(LogoSVG)
					<span>Timer</span>
				</a>
				<div class="row" style="align-items: center; gap: 0.6em">
					if user != nil {
						<span style="--type: -1; --fg: -0.5" class="tablet desktop">{ user.Email }</span>
						<a href="/logout" class="link" style="--type: -1">Sign out</a>
					} else {
						<a href="/oauth/google" class="link" style="--type: -1">Sign in</a>
					}
					@ThemeControls()
					<a href="https://github.com/Deufel/clock" target="_blank" rel="noopener" aria-label="Source" style="color: inherit; display: inline-flex">
						@templ.Raw(GitHubSVG)
					</a>
				</div>
			</header>
			<main class="pg-main">
				@content
			</main>
		</body>
	</html>
}

// ThemeControls renders the palette / theme / type-scale icon buttons.
// Reads from $theme, $hue, $typeIdx — these signals must be declared on an
// ancestor element (Shell declares them on body).
templ ThemeControls() {
	<button class="icon-btn" aria-label="Cycle color palette" data-on:click="$hue = ($hue + 30) % 360" title="Cycle color palette">
		@templ.Raw(PaletteSVG)
	</button>
	<button class="icon-btn" aria-label="Toggle theme" data-on:click="$theme = $theme === 'light' ? 'dark' : 'light'" title="Toggle theme">
		@templ.Raw(MoonSVG)
	</button>
	<button class="icon-btn" aria-label="Cycle text size" data-on:click="$typeIdx = ($typeIdx + 1) % 3" title="Cycle text size">
		@templ.Raw(TypeSizeSVG)
	</button>
}

// ---------------------------------------------------------------------------
// Landing — no shell, no SSE stream. Just a centered CTA.
// ---------------------------------------------------------------------------

templ Landing() {
	<!DOCTYPE html>
	<html lang="en" data-ui-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Timer</title>
			<link rel="stylesheet" href={ stickCSSHref }/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
		</head>
		<body class="stage">
			<div class="hud-overlay" style="min-block-size: 100svh; padding: 2rem">
				<div class="• column" style="align-items: center; gap: 1.5em; max-inline-size: 24rem">
					<div class="row" style="align-items: center; gap: 0.6em; --type: 2">
						@templ.Raw(LogoSVG)
						<span>Timer</span>
					</div>
					<p style="--fg: -0.5; text-align: center">A real-time task tracker. Built with Go, Datastar, and stick.css.</p>
					<a href="/oauth/google" class="btn row" style="--bg: 0.55; gap: 0.6em; align-items: center; text-decoration: none">
						@templ.Raw(GoogleIconSVG)
						<span>Sign in with Google</span>
					</a>
					<a href="/tasks" class="link" style="--type: -1">Or continue without an account →</a>
				</div>
			</div>
		</body>
	</html>
}

// ---------------------------------------------------------------------------
// Tasks page content. Goes inside Shell.
// ---------------------------------------------------------------------------

templ TasksContent(sid string, tasks []state.Task) {
	<div class="column" style="max-inline-size: 36rem; margin-inline: auto; gap: 1lh">
		<form class="row" style="gap: 0.5em; align-items: stretch" data-on:submit="event.preventDefault()">
			<input
				id="newtask-input"
				class="input"
				type="text"
				name="name"
				placeholder="What are you working on?"
				autocomplete="off"
				data-on:keydown="if(event.key==='Enter'){event.preventDefault(); const i=document.getElementById('newtask-input'); const n=i.value.trim(); if(n){@post('/tasks/add?name='+encodeURIComponent(n)); i.value=''}}"
				style="flex: 1"
			/>
			<button
				class="btn"
				type="button"
				data-on:click="const i=document.getElementById('newtask-input'); const n=i.value.trim(); if(n){@post('/tasks/add?name='+encodeURIComponent(n)); i.value=''}"
				style="--bg: 0.55; --type:0;"
			>Add</button>
		</form>
		@LiveRegion(tasks)
	</div>
}

// LiveRegion is the fat-morph target. The SSE stream re-renders this whole
// block on every state change (and at 60fps while anything is tracking).
templ LiveRegion(tasks []state.Task) {
	<div id="live" class="column" style="gap: 0.5lh">
		if len(tasks) == 0 {
			<p style="--fg: -0.5; text-align: center; padding: 2lh 0">No tasks yet. Add one above.</p>
		} else {
			for _, t := range tasks {
				@TaskRow(t)
			}
		}
	</div>
}

templ TaskRow(t state.Task) {
	<div
		class="card row"
		id={ fmt.Sprintf("task-%d", t.ID) }
		style="align-items: center; gap: 0.75em; padding: 0.6em 0.8em"
	>
		<span
			class="task-name"
			contenteditable="true"
			data-ignore-morph
			role="textbox"
			aria-label="Task name"
			data-on:blur={ fmt.Sprintf("@post('/tasks/rename?id=%d&name=' + encodeURIComponent(el.innerText.trim()))", t.ID) }
			data-on:keydown="if(event.key==='Enter'){event.preventDefault();el.blur()} if(event.key==='Escape'){el.innerText=el.dataset.original;el.blur()}"
			data-original={ t.Name }
			style="flex: 1; outline: none"
		>{ t.Name }</span>
		if t.Tracking() {
			<span class="tag suc" aria-label="Tracking" style="--type: -1">Tracking</span>
		}
		<span
			class="task-time"
			style="font-family: var(--font-mono, ui-monospace, monospace); --type: -0.5; --fg: -0.5; min-inline-size: 6em; text-align: right"
		>{ FmtElapsed(t.CurrentElapsed()) }</span>
		if t.Tracking() {
			<button
				class="btn"
				data-on:click={ fmt.Sprintf("@post('/tasks/stop?id=%d')", t.ID) }
				aria-label="Stop tracking"
				style="--type: -0.5; --bg: 0.7; --hue-lock: 0"
			>Stop</button>
		} else {
			<button
				class="btn"
				data-on:click={ fmt.Sprintf("@post('/tasks/track?id=%d')", t.ID) }
				aria-label="Start tracking"
				style="--type: -0.5"
			>Track</button>
		}
		<button
			class="icon-btn"
			data-on:click={ fmt.Sprintf("@post('/tasks/done?id=%d')", t.ID) }
			aria-label="Mark done"
			title="Mark done"
		>✓</button>
	</div>
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

type StatRow struct {
	Label string
	Value string
}

templ Admin(rows []StatRow) {
	<!DOCTYPE html>
	<html lang="en" data-ui-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Admin · Timer</title>
			<link rel="stylesheet" href={ stickCSSHref }/>
		</head>
		<body class="stage" style="padding: 2lh">
			<div class="column" style="max-inline-size: 32rem; margin-inline: auto; gap: 1lh">
				<div class="row spread" style="align-items: baseline">
					<span style="--type: 2">Admin</span>
					<a class="link" href="/tasks" style="--type: -1">← Tasks</a>
				</div>
				<div class="card stage column" style="padding: 1em">
					for _, r := range rows {
						<div class="row spread" style="padding: 0.3em 0; border-bottom: 1px solid var(--border)">
							<span style="--fg: -0.6">{ r.Label }</span>
							<span style="font-family: var(--font-mono, ui-monospace, monospace)">{ r.Value }</span>
						</div>
					}
				</div>
			</div>
		</body>
	</html>
}
